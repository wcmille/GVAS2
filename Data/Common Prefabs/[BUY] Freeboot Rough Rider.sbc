string auxString="BMCAux";public class AtmoSample{public double Elev;public double Atmo;public AtmoSample(double se,double sa)
{Atmo=sa;Elev=se;}}public class GravSample{public double altitude;public double sampleGrav;public GravSample(double
sampleGrav,double sampleAlt){altitude=sampleAlt;this.sampleGrav=sampleGrav;}public double Index(double decay){return Math.Pow(
altitude,decay)*sampleGrav;}}public class PlanetAtmo{public double ZeroAtmo{get;private set;}public double OneAtmo{get;private
set;}public double delta;AtmoSample sample=null;public PlanetAtmo(){ZeroAtmo=double.MaxValue;OneAtmo=double.MinValue;}
public void AtmoTest(float atmo,double elev){if(atmo==0.0&amp;&amp;elev&lt;ZeroAtmo)ZeroAtmo=Math.Min(elev,ZeroAtmo);else if(atmo&gt;=1.0&amp;&amp;
elev&gt;OneAtmo)OneAtmo=Math.Max(elev,OneAtmo);else RecordAtmoSample(elev,atmo);}void RecordAtmoSample(double elev,float
atmoPercent){var sam=new AtmoSample(elev,atmoPercent);if(sample==null){sample=sam;}else{delta=(atmoPercent-sample.Atmo)/(elev-
sample.Elev);ZeroAtmo=sample.Elev-sample.Atmo/delta;OneAtmo=sample.Elev+(1-sample.Atmo)/delta;}}public static double
CalcAtmoPercentFromAtmoThrustFraction(double tf){const double thrusterInterpDelta=1/0.7;return tf/thrusterInterpDelta+0.3;}internal void WriteText(
DisplayService ds){ds.WriteText("Atmosph --\n");if(ZeroAtmo&lt;double.MaxValue)ds.WriteText(
