MinValue)ds.WriteText($"1.0 atm {(delta&lt;0.0?"@":"above")} {OneAtmo:F1}m\n");if(sample!=null&amp;&amp;sample.Elev&lt;double.MaxValue)ds.
WriteText($"sam atm:{sample.Atmo:F2} @ {sample.Elev:F0}m\n");}}public class PlanetGrav{const double earthGrav=9.81;public double
terrainHeight;public double maxR=0.0;public double surfaceGrav=double.MaxValue;readonly double decay;Vector3D center;GravSample gsa,
gsb,gs;public PlanetGrav(Vector3D center,double seaLevel){this.center=center;RadiusToSurface=seaLevel;decay=7.0;}public
PlanetGrav(ShipController rc){if(rc.RC.TryGetPlanetPosition(out center)){decay=7.0;var distToCenter=(rc.GetPosition-center).Length
();double elev;rc.TryGetPlanetElevation(MyPlanetElevation.Sealevel,out elev);RadiusToSurface=distToCenter-elev;}}public
double RadiusToSurface{get;private set;}public void GravityTest(GravSample gs){this.gs=gs;if(gsa==null){gsa=gs;MakeGsa(gs);}
else if(gsa!=null&amp;&amp;gsa.Index(decay)&lt;gs.Index(decay)*0.99){gsb=gsa;gsa=gs;MakeGsa(gsa);MakeGsb();}else if(gsa!=null&amp;&amp;gsa.
Index(decay)&gt;gs.Index(decay)*1.01){if(gs.sampleGrav==gsa.sampleGrav)gsa=null;gsb=gs;MakeGsb();}}public Vector3D GetGravity(
Vector3D loc){var relPos=center-loc;var dist=relPos.Normalize();var alt=dist-RadiusToSurface;var gravity=surfaceGrav*relPos;if(
alt&gt;terrainHeight)gravity*=Math.Pow((terrainHeight+RadiusToSurface)/dist,decay);return gravity;}void MakeGsb(){surfaceGrav=
gsb.sampleGrav;if(gsa!=null)terrainHeight=Math.Pow(gsa.Index(decay)/surfaceGrav,1.0/decay);}void MakeGsa(GravSample gs){
maxR=Math.Pow(gs.Index(decay)/(0.05*earthGrav),1.0/decay);surfaceGrav=gs.Index(decay)/Math.Pow(RadiusToSurface,decay);}
internal void WriteText(DisplayService ds){ds.WriteText($"\nGravity --\n");ds.WriteText(
$"Sampl grv: {(gs.sampleGrav/earthGrav):F4}g @ {gs.altitude-RadiusToSurface:F0}m\n");if(gsa!=null)ds.WriteText($"\nSea Level: {RadiusToSurface:F1}m\nGrav Well: {maxR-RadiusToSurface:F0}m\n");if(gsa!=null
&amp;&amp;gsb==null)ds.WriteText($"Surf Grav (est): {surfaceGrav/earthGrav:F2}g\n");if(gsb!=null)ds.WriteText(
$"\nSurf Grav: {surfaceGrav/earthGrav:F2}g\n");if(gsb!=null&amp;&amp;gsa!=null)ds.WriteText($"Terrain : {terrainHeight-RadiusToSurface:F0}m");var gps=new MyWaypointInfo(
"Planet",center);ds.WriteText($"\n\n{gps}");}internal GravSample MakeSample(ShipController rc){var alt=(rc.GetPosition-center).
Length();var g=rc.NaturalGravity.Length();return new GravSample(g,alt);}}public class AtmoScience{readonly PlanetAtmo pa;
PlanetGrav pg;readonly IMyParachute chute;readonly ShipController rc;readonly DisplayService ds;public AtmoScience(ProgramCore pc,
