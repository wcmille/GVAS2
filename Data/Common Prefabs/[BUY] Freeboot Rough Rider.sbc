$"Toggle H2 Stockpile to {(off==0?"off":"on")} ({on} on{(off&gt;0?offStr:string.Empty)})";}public void UpdateBlocks(IMyGridTerminalSystem gts,IMyProgrammableBlock me){gts.GetBlocksOfType(oxyTanks,x=&gt;x.
