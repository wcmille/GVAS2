<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>KAMO-Behavior-PI</SubtypeId>
      </Id>
      <Description>
        [RivalAI Behavior]
        [BehaviorName:Passive]

        [UseBarrageFire:true]

        [Triggers:GVA-Trigger-StandardCompromised]
      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>KAMO-Behavior-Drone</SubtypeId>
      </Id>
      <Description>
        [RivalAI Behavior]
        [BehaviorName:Hunter]

        [AutopilotData:GVA-Autopilot-Common-Cruise]
        [SecondaryAutopilotData:GVA-Autopilot-Common-CapitalAttack]

        [TargetData:Common-Target-Main-A]
        [OverrideTargetData:Common-Target-Main-Combat]

        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]

        [WeaponSystem:GVA-Common-Weapons]

        [Triggers:GVA-Trigger-StandardCompromised]
        [Triggers:GVA-Trigger-Bingo]
        [Triggers:KAMO-Trigger-Drones]
      </Description>
    </EntityComponent>
  </EntityComponents>
</Definitions>