<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GVA-Loot-SmallTech</SubtypeId>
      </Id>
      <Description>
        [MES Loot]

        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockLargeContainer]
        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]

        [ContainerTypes:MES-ContainerTypes-RareTech-1]
        [ContainerTypes:MES-ContainerTypes-BasicComponents-1]
        [ContainerTypes:MES-ContainerTypes-MixedComponents-1]

        [ContainerTypes:MES-ContainerTypes-BasicIngots-1]
        [ContainerTypes:MES-ContainerTypes-MixedOres-1]
        [ContainerTypes:MES-ContainerTypes-BasicOres-2]

        [ContainerTypes:MES-ContainerTypes-Credits-1]
        [ContainerTypes:MES-ContainerTypes-Credits-1]
        [ContainerTypes:MES-ContainerTypes-Credits-2]

        [MinBlocks:1]
        [MaxBlocks:2]
      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GVA-Loot-MediumTech</SubtypeId>
      </Id>
      <Description>
        [MES Loot]

        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockLargeContainer]
        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]

        [ContainerTypes:MES-ContainerTypes-RareTech-1]
        [ContainerTypes:MES-ContainerTypes-RareTech-1]
        [ContainerTypes:MES-ContainerTypes-RareTech-2]

        [ContainerTypes:MES-ContainerTypes-AdvancedComponents-1]
        [ContainerTypes:MES-ContainerTypes-AdvancedComponents-2]
        [ContainerTypes:MES-ContainerTypes-AdvancedComponents-2]

        [ContainerTypes:MES-ContainerTypes-AdvancedIngots-1]
        [ContainerTypes:MES-ContainerTypes-AdvancedIngots-1]
        [ContainerTypes:MES-ContainerTypes-AdvancedIngots-2]

        [ContainerTypes:MES-ContainerTypes-Credits-2]
        [ContainerTypes:MES-ContainerTypes-Credits-2]
        [ContainerTypes:MES-ContainerTypes-Credits-3]

        [MinBlocks:2]
        [MaxBlocks:4]
      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GVA-Loot-GreatTech</SubtypeId>
      </Id>
      <Description>

        [MES Loot]

        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockLargeContainer]
        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]

        [ContainerTypes:MES-ContainerTypes-RareTech-1]
        [ContainerTypes:MES-ContainerTypes-RareTech-2]
        [ContainerTypes:MES-ContainerTypes-RareTech-3]

        [ContainerTypes:MES-ContainerTypes-AdvancedComponents-1]
        [ContainerTypes:MES-ContainerTypes-AdvancedComponents-1]
        [ContainerTypes:MES-ContainerTypes-AdvancedComponents-2]

        [ContainerTypes:MES-ContainerTypes-AdvancedIngots-1]
        [ContainerTypes:MES-ContainerTypes-AdvancedIngots-1]
        [ContainerTypes:MES-ContainerTypes-AdvancedIngots-2]

        [ContainerTypes:MES-ContainerTypes-Credits-2]
        [ContainerTypes:MES-ContainerTypes-Credits-2]
        [ContainerTypes:MES-ContainerTypes-Credits-3]

        [MinBlocks:3]
        [MaxBlocks:8]
      </Description>
    </EntityComponent>

    <!-- only using the loot groups because there is a bug with loot profiles used directly -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>GVA-Loot-Group</SubtypeId>
			</Id>
			<Description>
				[MES Loot Group]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>